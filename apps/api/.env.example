LOG_LEVEL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
DATABASE_URL=
DATABASE_DIRECT_URL=
CORS_ALLOWED_ORIGIN_REGEX=
SENTRY_DSN=
RESEND_API_KEY=
POSTHOG_API_KEY=
# Set by the deploy platform; reported by GET /v1/health.
GIT_SHA=
